# 必須: x.com にログイン中のブラウザの Cookie `auth_token` の値
# 取得方法: x.com にログイン → DevTools → Application → Cookies → https://x.com → auth_token
X_AUTH_TOKEN=

# 任意: エミュレートするクライアント (web / android / iphone / ipad / mac / old / tweetdeck)
# X_CLIENT=web

# 任意: プロキシ (protocol://user:pass@host:port)
# X_PROXY=

# 任意: 対象スクリーンネーム（カンマ区切り、@ なし）。
# 未設定なら src/config/screen-names.ts の DEFAULT_SCREEN_NAMES が使われる。
# SCREEN_NAMES=elonmusk,NASA,NintendoAmerica

# 任意: いいね数のしきい値（既定 10000）
# MIN_LIKES=10000

# 任意: 画像付きツイートに限定するか（既定 true）
# REQUIRE_IMAGES=true

# 任意: 何ヶ月前より古い投稿を対象にするか（検索演算子 until: に対応）。
# 例: 3 なら「3 ヶ月前より前」の投稿だけが対象。未設定なら期間の制限なし。
# 小数も可（0.5 = 約 15 日）。
# UNTIL_MONTHS_AGO=3

# 任意: 全期間を辿るときのページ数の安全上限（1 ページ 40 件、既定 40）
# 通常はカーソルが尽きて先に終わる。暴走防止用。
# MAX_PAGES=40

# 任意: 全期間の列挙中、ページ取得の間に空ける時間 ms（既定 400）。レート制限対策。
# PAGE_DELAY_MS=400

# 任意: 初回表示のために同期で辿るページ数の上限（既定 10）
# 期間指定で先頭ページに該当が 0 件のことがあるため、1 件見つかるまでここまで辿る
# MAX_SYNC_PAGES=10

# 任意: プールのキャッシュ有効期間 ms（既定 86400000 = 24 時間）
# CACHE_TTL_MS=86400000

# 任意: プールのディスクキャッシュ先（既定 .cache/buzz-pools）
# CACHE_DIR=.cache/buzz-pools

# 任意: アカウントを候補数で重み付けして選ぶか（既定 false = アカウントごとに等確率）
# true にすると全アカウントの全ツイートの中で一様になる
# WEIGHT_BY_POOL_SIZE=false
